using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System;

public class ChatbotAI : MonoBehaviour
{
    [Header("UI References")]
    public TMP_InputField userInput;        // Drag InputField here
    public Button sendButton;               // Drag Send button here
    public Transform chatContent;           // ScrollView Content
    public GameObject userMessagePrefab;    // User message prefab
    public GameObject botMessagePrefab;     // Bot message prefab
    public GameObject typingIndicator;      // Optional "Bot is typing..." text

    [Header("AI Manager")]
    public OpenAIManager openAIManager;     // Drag OpenAIManager here

    private Dictionary<string, string> faqDatabase;

    void Start()
    {
        // Initialize FAQ database
        faqDatabase = new Dictionary<string, string>()
        {
            { "hello", "Hi there! How can I help you today?" },
            { "hi", "Hello! What do you want to know?" },
            { "unity", "Unity is a game engine to create games and apps." },
            { "save project", "Go to File → Save Project to store your work." },
            { "play game", "Click Play ▶️ in the Unity Editor to test your project." },
            { "gameobject", "A GameObject is any object in your scene." },
            { "prefab", "A prefab is a reusable GameObject template." },
            { "c#", "C# is the programming language used in Unity." },
            { "thank you", "You're welcome! Keep learning Unity!" },
            { "bye", "Goodbye! See you later!" }
        };

        // Add listener to Send button
        sendButton.onClick.AddListener(OnSendButtonClicked);
    }

    void OnSendButtonClicked()
    {
        string message = userInput.text.Trim();
        if (string.IsNullOrEmpty(message)) return;

        // Show user message
        CreateMessage(userMessagePrefab, message);

        // Clear input
        userInput.text = "";

        // Show typing indicator
        if (typingIndicator != null)
            typingIndicator.SetActive(true);

        // Reply using FAQ or AI
        ReplyBot(message);
    }

    void ReplyBot(string userMessage)
    {
        string lowerMessage = userMessage.ToLower();

        // Check FAQ first
        foreach (var pair in faqDatabase)
        {
            if (lowerMessage.Contains(pair.Key))
            {
                if (typingIndicator != null)
                    typingIndicator.SetActive(false);

                CreateMessage(botMessagePrefab, pair.Value);
                return;
            }
        }

        // If not found, call OpenAI
        if (openAIManager != null)
        {
            openAIManager.SendMessageToAI(userMessage, (aiReply) =>
            {
                if (typingIndicator != null)
                    typingIndicator.SetActive(false);

                CreateMessage(botMessagePrefab, aiReply);
            });
        }
        else
        {
            if (typingIndicator != null)
                typingIndicator.SetActive(false);

            // Fallback
            string[] fallback = {
                "Hmm, I’m not sure about that.",
                "Can you ask in a different way?",
                "I don’t know yet, but I’m learning!"
            };
            CreateMessage(botMessagePrefab, fallback[UnityEngine.Random.Range(0, fallback.Length)]);
        }
    }

    void CreateMessage(GameObject prefab, string text)
    {
        GameObject msg = Instantiate(prefab, chatContent);
        TMP_Text msgText = msg.GetComponentInChildren<TMP_Text>();
        msgText.text = text;
    }
}
